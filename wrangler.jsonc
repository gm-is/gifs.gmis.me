{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gifs-gmis-me",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    {
      "pattern": "gifs.gmis.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
